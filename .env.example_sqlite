# SQLite settings.
#
# 1. Copy this file to a new file named .env
# 2. The defaults work as they are. Edit a line only if you want to change it.
#
# Edit .env, not this file, because this example file is tracked by git.


# DATABASE NAME (must end in .db)
DB_FILENAME=kayaking.db


# DATABASE LOCATION
# Default: the project folder, next to the code.
# To change the location, remove the # from the line below.
# Set a full path to a folder that already exists.
# DB_PARENT_DIRECTORY=/full/path/to/parent_folder