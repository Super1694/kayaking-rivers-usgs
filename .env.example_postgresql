# PostgreSQL settings. Skip this file if you are using SQLite.
#
# 1. Copy this file to a new file named .env
# 2. Edit the values in .env, not in this file.
#
# Git ignores only a file named exactly .env, so your credentials stay local.
# This example file is tracked by git. Never put real credentials in it.

# FOR USER CUSTOMIZATION
DB_HOST=192.0.2.1
DB_PORT=5432
DB_USER=postgres_user_name
DB_PASSWORD=postgres_user_password
DB_NAME=postgres_database

# DO NOT CHANGE THE FOLLOWING LINE
DB_TYPE=postgresql